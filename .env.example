# The web UI binds to localhost by default because it has no user
# authentication. Non-loopback binding is advanced and unsupported; a trusted
# LAN is not an authentication boundary. Direct public exposure is unsupported.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Advanced reverse-proxy deployments may allow exact additional Host header
# values as a comma-separated list. Wildcards, URLs, ports, and CIDR ranges are
# rejected. This does not authenticate the web UI or make remote exposure safe.
# MEME_SEARCH_ALLOWED_HOSTS=memes.example.internal

# Optional persistent storage locations. Relative defaults are used when these
# are left commented out.
# MEME_SEARCH_DB_PATH=./meme_search/db_data/meme-search-db
# MEME_SEARCH_DIRECT_UPLOADS_PATH=./meme_search/direct-uploads
# MEME_SEARCH_GENERATOR_DB_PATH=./meme_search/db_data/image_to_text_generator
# MEME_SEARCH_MODELS_PATH=./meme_search/models

# Model that turns descriptions and search queries into vectors. Unset keeps the
# English default (sentence-transformers/all-MiniLM-L6-v2). For non-English
# memes use sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2. Vectors
# of different models are not comparable: after changing this, run
# docker compose exec meme_search bin/rails embeddings:rebuild
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Description generation is local by default.
IMAGE_DESCRIPTION_PROVIDER=local

# Local provider only: seconds the image-to-text model stays loaded after the
# last description job before its memory (RAM or GPU) is released. 0 keeps it
# loaded until the service stops.
# MODEL_IDLE_TIMEOUT=300

# Only required when IMAGE_DESCRIPTION_PROVIDER=openai.
# Images selected for description generation are sent to this endpoint.
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini

# How many OpenAI-compatible description jobs the worker runs at once. Set 1
# for a local server that handles one request at a time (Ollama). Max 3 unless
# the database pool in config/database.yml is raised.
# JOB_THREADS=3
